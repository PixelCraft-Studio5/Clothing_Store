  gap: 8px;

  flex-shrink: 0;

  margin-bottom: 2px;

  font-family: "DM Mono", monospace;

  font-size: 9px;

  letter-spacing: 2px;

  color: #77746d;
}

.count-orange {
  color: #ff5318;

  font-size: 18px;

  line-height: 0;
}

.count-number {
  color: #ff5318;
}

.count-label {
  color: #77746d;
}

/* =========================================
   HOVER OVERLAY
========================================= */

.collection-overlay {
  position: absolute;

  inset: 0;

  z-index: 6;

  display: flex;

  align-items: center;

  justify-content: center;

  gap: 12px;

  background: rgba(255, 83, 24, 0.88);

  color: #11110f;

  font-family: "Archivo Black", sans-serif;

  font-size: 13px;

  letter-spacing: 1px;

  opacity: 0;

  transform: translateY(10px);

  transition:
    opacity 0.35s ease,
    transform 0.35s ease;

  pointer-events: none;
}

/* =========================================
   HOVER
========================================= */

.collection-card:hover .collection-overlay {
  opacity: 1;

  transform: translateY(0);
}

.collection-card:hover .collection-tag {
  z-index: 7;

  background: #ff5318;

  color: #11110f;
}

.collection-card:hover .collection-info {
  z-index: 7;
}

.collection-card:hover .collection-info h2,
.collection-card:hover .collection-count,
.collection-card:hover .count-orange,
.collection-card:hover .count-number,
.collection-card:hover .count-label {
  color: #11110f;
}

.collection-card:hover img {
  transform: scale(1.04);

  filter:
    grayscale(0%)
    contrast(1.1)
    brightness(0.9);
}

/* =========================================
   MOBILE
========================================= */

@media (max-width: 900px) {

  .collection-page {
    padding: 0 30px 50px;
  }

  .collection-header {
    height: 160px;
  }

  .collection-heading {
    font-size: 65px;

    letter-spacing: -4px;
  }

  .collection-grid {
    gap: 24px;
  }

  .collection-image {
    height: 330px;
  }

  .collection-info {
    left: 20px;
    right: 20px;
  }

  .collection-info h2 {
    font-size: 26px;
  }
}

/* =========================================
   PHONE
========================================= */

@media (max-width: 650px) {

  .collection-page {
    padding: 0 18px 40px;
  }

  .collection-header {
    height: 145px;

    padding-bottom: 22px;
  }

  .collection-heading {
    font-size: 52px;

    letter-spacing: -3px;
  }

  .collection-index {
    display: none;
  }

  .collection-grid {
    grid-template-columns: 1fr;

    gap: 20px;

    padding-top: 30px;
  }

  .collection-image {
    height: clamp(300px, 105vw, 420px);
  }

  .collection-info h2 {
    min-width: 0;
    font-size: clamp(21px, 7vw, 30px);
  }

  .collection-count {
    gap: 5px;
    font-size: 8px;
    letter-spacing: 1px;
  }

  .collection-info {
    left: 14px;
    right: 14px;
    gap: 10px;
  }

  .collection-tag {
    top: 14px;
    left: 14px;
    max-width: calc(100% - 28px);
    overflow: hidden;
    text-overflow: ellipsis;
  }
}
</file>

<file path="src/styles/FinalCTA.css">
/* =========================================
   FINAL CTA
========================================= */

.final-cta {
  position: relative;

  min-height: 620px;

  display: flex;

  align-items: center;

  justify-content: center;

  overflow: hidden;

  background: #11110f;

  color: #f0eee8;
}


/* =========================================
   ORANGE PAGE BREAKER
========================================= */

.final-cta-line {
  position: absolute;

  top: 0;

  left: 0;

  width: 100%;

  height: 2px;

  background: #ff5318;
}


/* =========================================
   CONTENT
========================================= */

.final-cta-content {
  position: relative;

  z-index: 2;

  width: 100%;

  max-width: 850px;

  padding: 70px 30px 50px;

  text-align: center;
}


/* =========================================
   KICKER
========================================= */

.final-cta-kicker {
  margin: 0 0 22px;

  color: #ff5318;

  font-family: "DM Mono", monospace;

  font-size: 10px;

  letter-spacing: 3px;

  text-transform: uppercase;
}


/* =========================================
   TITLE
========================================= */

.final-cta-title {
  position: relative;

  display: flex;

  flex-direction: column;

  align-items: center;

  margin: 0;

  font-family:
    "Archivo Black",
    sans-serif;

  font-size: clamp(
    70px,
    9vw,
    125px
  );

  line-height: 0.78;

  letter-spacing: -7px;

  text-transform: uppercase;
}

.final-cta-white {
  color: #f0eee8;
}

.final-cta-orange {
  color: #ff5318;
}


/* =========================================
   BACKGROUND SHOP
========================================= */

.final-cta-background {
  position: absolute;

  top: 110px;

  left: 50%;

  transform: translateX(-50%);

  z-index: -1;

  font-family:
    "Archivo Black",
    sans-serif;

  font-size: clamp(
    160px,
    22vw,
    300px
  );

  line-height: 1;

  letter-spacing: -15px;

  color: transparent;

  -webkit-text-stroke: 1px
    rgba(
      240,
      238,
      232,
      0.08
    );

  white-space: nowrap;

  pointer-events: none;
}


/* =========================================
   DESCRIPTION
========================================= */

.final-cta-description {
  position: relative;

  margin: 30px auto 25px;

  color: #aaa69f;

  font-family:
    "DM Mono",
    monospace;

  font-size: 11px;

  line-height: 2;

  letter-spacing: 0.5px;
}


/* =========================================
   BUTTON
========================================= */

.final-cta-button {
  position: relative;

  min-width: 196px;

  height: 56px;

  padding: 0 30px;

  border: none;

  background: #f0eee8;

  color: #151514;

  font-family:
    "Archivo Black",
    sans-serif;

  font-size: 12px;

  letter-spacing: 0.5px;

  cursor: pointer;

  clip-path: polygon(
    0 0,
    94% 0,
    100% 22%,
    100% 78%,
    94% 100%,
    6% 100%,
    0 78%,
    0 22%
  );

  transition:
    background 0.25s ease,
    color 0.25s ease,
    transform 0.25s ease;
}

.final-cta-button:hover {
  background: #ff5318;

  color: #151514;

  transform: translateY(-3px);
}


/* =========================================
   BENEFITS
========================================= */

.final-cta-benefits {
  display: flex;

  align-items: center;

  justify-content: center;

  gap: 38px;

  margin-top: 55px;

  color: #77736d;

  font-family:
    "DM Mono",
    monospace;

  font-size: 8px;

  letter-spacing: 2.5px;

  white-space: nowrap;
}

.final-cta-benefits b {
  color: #ff5318;

  font-weight: normal;
}


/* =========================================
   MOBILE
========================================= */

@media (max-width: 700px) {

  .final-cta {
    min-height: 600px;
  }

  .final-cta-title {
    font-size: 68px;

    letter-spacing: -5px;
  }

  .final-cta-background {
    top: 180px;

    font-size: 150px;

    letter-spacing: -10px;
  }

  .final-cta-description {
    font-size: 9px;
  }

  .final-cta-benefits {
    flex-direction: column;

    gap: 12px;

    margin-top: 40px;

    white-space: normal;
  }

  .final-cta-benefits b {
    display: none;
  }

}

@media (max-width: 360px) {
  .final-cta-content {
    padding-right: 18px;
    padding-left: 18px;
  }

  .final-cta-title {
    font-size: 58px;
    letter-spacing: -4px;
  }

  .final-cta-kicker {
    font-size: 8px;
    letter-spacing: 2px;
  }

  .final-cta-background {
    font-size: 125px;
    letter-spacing: -8px;
  }

  .final-cta-description br {
    display: none;
  }

  .final-cta-description {
    max-width: 30ch;
  }
}
</file>

<file path="src/styles/Footer.css">
/* =========================================
   PIXEL FOOTER
========================================= */

.pixel-footer {
  position: relative;

  background: #11110f;

  color: #f0eee8;

  border-top: 1px solid
    rgba(
      240,
      238,
      232,
      0.14
    );

  font-family:
    "DM Mono",
    monospace;
}


/* =========================================
   MAIN FOOTER
========================================= */

.footer-main {
  display: grid;

  grid-template-columns:
    1.5fr
    1fr
    1fr
    1fr;

  gap: 70px;

  padding: 68px 44px 55px;
}


/* =========================================
   LOGO
========================================= */

.footer-logo {
  display: flex;

  align-items: baseline;

  margin-bottom: 25px;

  font-family:
    "Archivo Black",
    sans-serif;

  font-size: 27px;

  letter-spacing: -2px;
}

.footer-logo span:first-child {
  color: #f0eee8;
}

.footer-logo span:last-child {
  color: #ff5318;
}


/* =========================================
   BRAND DESCRIPTION
========================================= */

.footer-brand p {
  margin: 0;

  color: #77736d;

  font-size: 10px;

  line-height: 2.1;

  letter-spacing: 0.3px;
}


/* =========================================
   FOOTER COLUMNS
========================================= */

.footer-column {
  display: flex;

  flex-direction: column;

  gap: 17px;
}

.footer-column h3 {
  margin: 0 0 7px;

  color: #77736d;

  font-size: 9px;

  font-weight: normal;

  letter-spacing: 3px;
}

.footer-column a {
  width: fit-content;

  color: #d5d1c9;

  text-decoration: none;

  font-size: 9px;

  letter-spacing: 2px;

  transition:
    color 0.2s ease,
    transform 0.2s ease;
}

.footer-column a:hover {
  color: #ff5318;

  transform: translateX(4px);
}


/* =========================================
   FOOTER BOTTOM
========================================= */

.footer-bottom {
  display: flex;

  align-items: center;

  justify-content: space-between;

  gap: 30px;

  margin: 0 44px;

  padding: 25px 0 27px;

  border-top: 1px solid
    rgba(
      240,
      238,
      232,
      0.14
    );
}


/* =========================================
   COPYRIGHT
========================================= */

.footer-copyright,
.footer-disclaimer {
  color: #77736d;

  font-size: 8px;

  letter-spacing: 2px;

  white-space: nowrap;
}


/* =========================================
   TECHNICAL BARS
========================================= */

.footer-bars {
  display: flex;

  align-items: center;

  gap: 4px;

  flex: 1;

  max-width: 235px;

  justify-content: center;
}

.footer-bars span {
  width: 2px;

  height: 9px;

  background: #44423e;

  opacity: 0.8;
}


/* =========================================
   MOBILE
========================================= */

@media (max-width: 800px) {

  .footer-main {
    grid-template-columns:
      1fr 1fr;

    gap: 50px 35px;

    padding: 55px 25px;
  }

  .footer-brand {
    grid-column: span 2;
  }

  .footer-bottom {
    align-items: flex-start;

    flex-direction: column;

    margin: 0 25px;

    gap: 22px;
  }

  .footer-bars {
    order: 3;

    width: 100%;

    max-width: none;

    justify-content: flex-start;
  }

}


@media (max-width: 500px) {

  .footer-main {
    grid-template-columns: 1fr;

    gap: 38px;
  }

  .footer-brand {
    grid-column: auto;
  }

  .footer-column {
    gap: 14px;
  }

  .footer-disclaimer {
    white-space: normal;

    line-height: 1.7;
  }

}
