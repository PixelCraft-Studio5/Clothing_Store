<file path="src/styles/inked.css">
/* =========================================
   INKED PAGE
========================================= */

.inked-page {
  position: relative;

  min-height: 100vh;

  background: #f0eee8;
  color: #181817;

  overflow: hidden;

  font-family: "DM Mono", monospace;
}

/* =========================================
   BACKGROUND SS26
========================================= */

.inked-background-text {
  position: absolute;

  right: -70px;
  top: 115px;

  font-family: "Archivo Black", sans-serif;

  font-size: clamp(180px, 26vw, 390px);

  line-height: 0.8;

  letter-spacing: -18px;

  color: transparent;

  -webkit-text-stroke: 1px rgba(24, 24, 23, 0.12);

  user-select: none;

  z-index: 0;
}

/* =========================================
   MAIN LAYOUT
========================================= */

.inked-main {
  position: relative;

  min-height: 100vh;

  display: grid;

  grid-template-columns: 48% 52%;

  align-items: center;

  padding: 70px 42px;

  z-index: 2;
}

/* =========================================
   LEFT CONTENT
========================================= */

.inked-copy {
  align-self: center;

  padding-top: 10px;
}

/* =========================================
   TITLE
========================================= */

.inked-title {
  display: flex;

  flex-direction: column;

  margin: 0 0 22px;

  font-family: "Archivo Black", sans-serif;

  font-size: clamp(60px, 6.5vw, 100px);

  line-height: 0.82;

  letter-spacing: -5px;

  text-transform: uppercase;
}

.inked-title span {
  display: block;
}

.inked-title .orange-word {
  color: #ff5318;
}

/* =========================================
   DESCRIPTION
========================================= */

.inked-description {
  margin-top: 28px;

  max-width: 390px;

  color: #34322e;

  font-size: 12px;

  line-height: 1.65;

  letter-spacing: 0.1px;
}

/* =========================================
   BUTTONS
========================================= */

.inked-buttons {
  display: flex;

  align-items: center;

  gap: 19px;

  margin-top: 38px;
}

/* =========================================
   PRIMARY BUTTON
========================================= */

.inked-primary-button {
  position: relative;

  min-width: 197px;

  height: 56px;

  padding: 0 20px;

  display: flex;

  align-items: center;

  justify-content: center;

  gap: 18px;

  background: #181817;

  color: #f0eee8;

  font-family: "Archivo Black", sans-serif;

  font-size: 12px;

  cursor: pointer;

  clip-path: polygon(
    0 0,
    94% 0,
    100% 22%,
    100% 100%,
    7% 100%,
    0 78%
  );

  transition:
    background 0.2s ease,
    transform 0.2s ease;
}

.inked-primary-button:hover {
  background: #ff5318;

  color: #181817;

  transform: translateY(-2px);
}

/* =========================================
   SECONDARY BUTTON
========================================= */

.inked-secondary-button {
  min-width: 185px;

  height: 56px;

  padding: 0 25px;

  background: transparent;

  border: 2px solid #181817;

  color: #181817;

  font-family: "Archivo Black", sans-serif;

  font-size: 12px;

  cursor: pointer;

  transition:
    background 0.2s ease,
    color 0.2s ease;
}

.inked-secondary-button:hover {
  background: #181817;

  color: #f0eee8;
}

/* =========================================
   SPEC PANEL
========================================= */

.inked-spec-wrapper {
  position: relative;

  min-height: 440px;

  display: flex;

  align-items: center;

  justify-content: center;

  z-index: 4;
}

.inked-spec {
  position: relative;

  width: 410px;

  margin-left: 60px;

  padding: 45px 35px;

  color: #34322e;

  font-size: 10px;

  line-height: 1.8;

  letter-spacing: 2px;
}

/* =========================================
   SPEC TITLE
========================================= */

.spec-line {
  margin-bottom: 10px;

  font-size: 10px;

  letter-spacing: 3px;
}

.spec-divider {
  width: 60px;

  height: 1px;

  margin-bottom: 20px;

  background: #181817;
}

/* =========================================
   SPEC DETAILS
========================================= */

.spec-details {
  display: flex;

  flex-direction: column;

  gap: 4px;

  font-size: 9px;

  letter-spacing: 2px;
}

/* =========================================
   SUBTLE TECHNICAL GRID
========================================= */

.inked-page::before {
  content: "";

  position: absolute;

  right: 0;

  top: 0;

  width: 50%;

  height: 100%;

  background-image:
    linear-gradient(
      rgba(24, 24, 23, 0.025) 1px,
      transparent 1px
    ),
    linear-gradient(
      90deg,
      rgba(24, 24, 23, 0.025) 1px,
      transparent 1px
    );

  background-size: 45px 45px;

  pointer-events: none;
}

/* =========================================
   RESPONSIVE
========================================= */

@media (max-width: 1000px) {

  .inked-main {
    grid-template-columns: 1fr;

    padding: 80px 40px;
  }

  .inked-copy {
    max-width: 600px;
  }

  .inked-spec-wrapper {
    justify-content: flex-start;

    min-height: 300px;
  }

  .inked-spec {
    margin-left: 0;
    padding-left: 0;
  }

  .inked-background-text {
    right: -50px;

    top: 420px;

    font-size: 250px;
  }
}

@media (max-width: 650px) {

  .inked-main {
    padding: 55px 25px;
  }

  .inked-title {
    font-size: 57px;

    letter-spacing: -3px;
  }

  .inked-description {
    font-size: 11px;

    max-width: 330px;
  }

  .inked-buttons {
    flex-direction: column;

    align-items: flex-start;

    gap: 12px;
  }

  .inked-primary-button,
  .inked-secondary-button {
    width: 190px;
  }

  .inked-spec {
    width: 100%;
    max-width: 100%;
    overflow-wrap: anywhere;
  }

  .inked-background-text {
    font-size: 180px;

    top: 500px;

    right: -30px;
  }
}

@media (max-width: 360px) {
  .inked-main {
    padding-right: 18px;
    padding-left: 18px;
  }

  .inked-title {
    font-size: clamp(43px, 14vw, 52px);
    letter-spacing: -2.5px;
  }

  .inked-spec {
    font-size: 8px;
    letter-spacing: 1.2px;
  }

  .spec-details {
    font-size: 8px;
    letter-spacing: 1.1px;
  }
}
</file>

<file path="src/styles/lookbook.css">
/* =========================================
   LOOKBOOK PAGE
========================================= */

.lookbook-page {
  min-height: 100vh;

  padding: 80px 42px 55px;

  background: #11110f;

  color: #f0eee8;

  overflow: hidden;

  font-family: "DM Mono", monospace;
}


/* =========================================
   HEADER
========================================= */

.lookbook-header {
  display: flex;

  align-items: flex-end;

  justify-content: space-between;

  padding-bottom: 25px;

  border-bottom: 1px solid rgba(
    240,
    238,
    232,
    0.16
  );
}


/* =========================================
   TITLE
========================================= */

.lookbook-title {
  display: flex;

  align-items: baseline;

  margin: 0;

  font-family: "Archivo Black", sans-serif;

  font-size: clamp(
    65px,
    6vw,
    95px
  );

  line-height: 0.8;

  letter-spacing: -5px;

  text-transform: uppercase;
}

.lookbook-white {
  color: #f0eee8;
}

.lookbook-orange {
  color: #ff5318;
}


/* =========================================
   HEADER META
========================================= */

.lookbook-header-meta {
  margin-bottom: 7px;

  color: #7d7971;

  font-size: 9px;

  letter-spacing: 3px;
}


/* =========================================
   IMAGE GRID
========================================= */

.lookbook-grid {
  display: grid;

  grid-template-columns:
    minmax(0, 1.55fr)
    minmax(0, 1fr);

  gap: 29px;

  margin-top: 48px;
}


/* =========================================
   IMAGE
========================================= */

.lookbook-image {
  position: relative;

  overflow: hidden;

  background: #050505;

  border: 1px solid rgba(
    255,
    255,
    255,
    0.025
  );
}


/* =========================================
   IMAGE SIZES
========================================= */

.lookbook-main-image {
  height: 510px;
}

.lookbook-side-image {
  height: 510px;
}


/* =========================================
   PLACEHOLDER
========================================= */

.lookbook-placeholder {
  position: absolute;

  inset: 0;

  display: flex;

  align-items: center;

  justify-content: center;

  background:
    radial-gradient(
      circle at center,
      rgba(
        255,
        255,
        255,
        0.04
      ),
      transparent 50%
    ),
    #050505;
}


/* =========================================
   TECHNICAL DOT TEXTURE
========================================= */

.lookbook-placeholder::before,
.lookbook-image::before {
  content: "";

  position: absolute;

  inset: 0;

  background-image:
    radial-gradient(
      rgba(
        255,
        255,
        255,
        0.12
      ) 0.6px,
      transparent 0.6px
    );

  background-size: 5px 5px;

  opacity: 0.14;

  pointer-events: none;

  z-index: 1;
}


.lookbook-placeholder span {
  position: relative;

  z-index: 2;

  padding: 16px 24px;

  border: 1px dashed #44423d;

  color: #55534e;

  font-size: 11px;

  letter-spacing: 4px;
}


/* =========================================
   REAL IMAGE
========================================= */

.lookbook-image img {
  width: 100%;

  height: 100%;

  display: block;

  object-fit: cover;

  filter:
    grayscale(25%)
    contrast(1.15)
    brightness(0.8);

  transition:
    transform 0.7s
    cubic-bezier(
      0.2,
      0.7,
      0.2,
      1
    );
}


.lookbook-image:hover img {
  transform: scale(1.025);
}


/* =========================================
   NUMBER
========================================= */

.lookbook-number {
  position: absolute;

  top: 20px;

  right: 23px;

  z-index: 5;

  font-family: "Archivo Black", sans-serif;

  font-size: 32px;

  line-height: 1;

  color: #f0eee8;
}


/* =========================================
   CAPTION
========================================= */

.lookbook-caption {
  position: absolute;

  left: 34px;

  bottom: 30px;

  z-index: 5;

  padding: 10px 14px;

  background: rgba(
    10,
    10,
    9,
    0.92
  );

  color: #f0eee8;

  font-size: 9px;

  letter-spacing: 2px;
}


/* =========================================
   BOTTOM SECTION
========================================= */

.lookbook-footer {
  display: flex;

  align-items: flex-start;

  justify-content: space-between;

  gap: 40px;

  margin-top: 42px;
}


/* =========================================
   STATEMENT
========================================= */

.lookbook-statement {
  display: flex;

  flex-direction: column;

  margin: 0;

  font-family: "Archivo Black", sans-serif;

  font-size: clamp(
    38px,
    4vw,
    61px
  );

  line-height: 0.8;

  letter-spacing: -3px;

  text-transform: uppercase;
}

.statement-orange {
  color: #ff5318;
}


/* =========================================
   TECHNICAL INFO
========================================= */

.lookbook-technical {
  padding-top: 5px;

  color: #858078;

  font-size: 9px;

  line-height: 2;

  letter-spacing: 2px;

  text-align: left;
}


/* =========================================
   TABLET
========================================= */

@media (max-width: 900px) {

  .lookbook-page {
    padding: 60px 30px 45px;
  }

  .lookbook-grid {
    gap: 20px;
  }

  .lookbook-main-image,
  .lookbook-side-image {
    height: clamp(300px, 110vw, 430px);
  }

  .lookbook-caption {
    right: 12px;
    bottom: 14px;
    left: 12px;
    max-width: calc(100% - 24px);
    padding: 9px 10px;
    font-size: 7px;
    letter-spacing: 1px;
    line-height: 1.5;
  }

  .lookbook-number {
    top: 14px;
    right: 14px;
    font-size: 26px;
  }

  .lookbook-footer {
    flex-direction: column;
  }

}


/* =========================================
   MOBILE
========================================= */

@media (max-width: 650px) {

  .lookbook-page {
    padding: 45px 20px 35px;
  }

  .lookbook-header {
    align-items: flex-start;

    flex-direction: column;

    gap: 15px;
  }

  .lookbook-title {
    font-size: 58px;

    letter-spacing: -4px;
  }

  .lookbook-header-meta {
    font-size: 8px;

    margin-bottom: 0;
  }

  .lookbook-grid {
    grid-template-columns: 1fr;

    margin-top: 30px;

    gap: 18px;
  }

  .lookbook-main-image,
  .lookbook-side-image {
    height: clamp(300px, 110vw, 430px);
  }

  .lookbook-footer {
    margin-top: 30px;

    gap: 30px;
  }

  .lookbook-statement {
    font-size: 43px;
  }

  .lookbook-technical {
    font-size: 8px;
    letter-spacing: 1.4px;
    overflow-wrap: anywhere;
  }

}

@media (max-width: 360px) {
  .lookbook-page {
    padding-right: 16px;
    padding-left: 16px;
  }

  .lookbook-title {
    font-size: 52px;
  }

  .lookbook-statement {
    font-size: 37px;
    letter-spacing: -2px;
  }
}
</file>

<file path="src/styles/new-in.css">
/* =========================================
   NEW IN PAGE
========================================= */

.new-in-page {
  min-height: 100vh;

  background: #f0eee8;

  color: #151514;

  padding: 0 42px 70px;

  font-family: "DM Mono", monospace;
}


/* =========================================
   HEADER
========================================= */

.new-in-header {
  display: flex;

  align-items: flex-end;

  justify-content: space-between;

  min-height: 180px;

  padding-top: 24px;

  padding-bottom: 26px;

  border-bottom: 1px solid
    rgba(20, 20, 19, 0.2);
}


/* =========================================
   TITLE
========================================= */

.new-in-title {
  display: flex;

  flex-direction: column;

  margin: 0;

  font-family:
    "Archivo Black",
    sans-serif;

  font-size: clamp(
    62px,
    6vw,
    92px
  );

  line-height: 0.68;

  letter-spacing: -4px;

  text-transform: uppercase;
}

.new-in-title span {
  display: block;
}

.new-in-title .orange {
  color: #ff5318;
}


/* =========================================
   HEADER COUNT
========================================= */

.new-in-count {
  padding-bottom: 6px;

  color: #67645e;

  font-size: 8px;

  letter-spacing: 3px;

  text-transform: uppercase;
}


/* =========================================
   PRODUCT LIST
========================================= */

.new-in-list {
  margin-top: 48px;

  border-top: 1px solid
    rgba(20, 20, 19, 0.2);
}


/* =========================================
   PRODUCT ROW
========================================= */

.new-in-row {
  display: grid;

  grid-template-columns:
    65px
    minmax(260px, 1.2fr)
    minmax(300px, 1.3fr)
    120px
    minmax(140px, 160px);

  align-items: center;

  min-height: 86px;

  border-bottom: 1px solid
    rgba(20, 20, 19, 0.2);

  gap: 20px;
}


/* =========================================
   NUMBER
========================================= */

.new-in-number {
  color: #aaa69e;

  font-family:
    "Archivo Black",
    sans-serif;

  font-size: 21px;

  letter-spacing: -1px;
}


/* =========================================
   PRODUCT NAME
========================================= */

.new-in-product h2 {
  margin: 0;

  font-family:
    "Archivo Black",
    sans-serif;

  font-size: 25px;

  line-height: 1;

  letter-spacing: -1px;

  text-transform: uppercase;
}

.new-in-product h2 span {
  color: #ff5318;
}


/* =========================================
   DESCRIPTION
========================================= */

.new-in-description {
  position: relative;

  padding-right: 15px;
}

.new-in-description p {
  margin: 0;

  color: #625e57;

  font-size: 9px;

  line-height: 1.7;

  letter-spacing: 1.6px;

  text-transform: uppercase;
}


/* =========================================
   ANIME LABEL
========================================= */

.new-in-anime {
  display: inline-block;

  margin-top: 5px;

  color: #ff5318;

  font-size: 7px;

  letter-spacing: 2px;

  text-transform: uppercase;
}


/* =========================================
   PRICE
========================================= */

.new-in-price {
  display: flex;

  flex-direction: column;

  align-items: flex-end;
}

.new-in-price strong {
  font-family:
    "Archivo Black",
    sans-serif;

  font-size: 18px;

  letter-spacing: -1px;
}

.new-in-price span {
  color: #9b978f;

  font-size: 7px;

  letter-spacing: 1px;
}


/* =========================================
   PRODUCT ACTIONS
========================================= */

.new-in-actions {
  display: flex;

  flex-direction: column;

  gap: 5px;
}

.new-in-add {
  position: relative;

  display: flex;

  align-items: center;

  justify-content: center;

  min-height: 31px;

  background: #151514;

  color: #f0eee8;

  padding: 0 8px;

  font-family:
    "Archivo Black",
    sans-serif;

  font-size: 9px;

  letter-spacing: 1px;

  cursor: pointer;

  text-align: center;

  text-decoration: none;

  white-space: nowrap;

  clip-path: polygon(
    0 0,
    87% 0,
    100% 50%,
    87% 100%,
    0 100%,
    12% 50%
  );

  transition:
    background 0.2s ease,
    color 0.2s ease;
}

.new-in-view {
  display: flex;

  align-items: center;

  justify-content: center;

  min-height: 31px;

  padding: 0 8px;

  border: 1px solid rgba(20, 20, 19, 0.28);

  color: #151514;

  font-family: "Archivo Black", sans-serif;

  font-size: 7px;

  letter-spacing: 0.5px;

  text-align: center;

  white-space: nowrap;

  transition:
    background 0.2s ease,
    color 0.2s ease,
    border-color 0.2s ease;
}

.new-in-view:hover {
  border-color: #ff5318;

  background: #ff5318;

  color: #151514;
}

.new-in-add {
  border: 0;

  font-family: "Archivo Black", sans-serif;
}

.new-in-add:hover {
  background: #ff5318;

  color: #151514;
}


/* =========================================
   TABLET
========================================= */

@media (max-width: 900px) {
  .new-in-page {
    padding-right: 30px;
    padding-left: 30px;
  }

  .new-in-row {
    grid-template-columns: 38px minmax(0, 1fr) 100px 132px;
    gap: 10px 14px;
    padding: 16px 0;
  }

  .new-in-number {
    grid-column: 1;
    grid-row: 1 / span 2;
    align-self: start;
  }

  .new-in-product {
    grid-column: 2;
    grid-row: 1;
    min-width: 0;
  }

  .new-in-product h2 {
    font-size: clamp(16px, 2.4vw, 21px);
    line-height: 1.1;
  }

  .new-in-description {
    grid-column: 2;
    grid-row: 2;
    min-width: 0;
    padding-right: 0;
  }

  .new-in-description p {
    font-size: 8px;
    overflow-wrap: anywhere;
  }

  .new-in-price {
    grid-column: 3;
    grid-row: 1 / span 2;
    align-items: flex-end;
  }

  .new-in-actions {
    grid-column: 4;
    grid-row: 1 / span 2;
  }
}

@media (min-width: 901px) and (max-width: 1050px) {

  .new-in-row {
    grid-template-columns:
      45px
      minmax(220px, 1fr)
      minmax(230px, 1fr)
      90px
      135px;

    gap: 12px;
  }

  .new-in-product h2 {
    font-size: 21px;
  }

  .new-in-description p {
    font-size: 8px;
  }

}


/* =========================================
   MOBILE
========================================= */

@media (max-width: 760px) {

  .new-in-page {
    padding: 0 20px 50px;
  }


  .new-in-header {
    min-height: 158px;

    align-items: flex-start;

    flex-direction: column;

    justify-content: flex-end;

    gap: 12px;

    padding-top: 20px;

    padding-bottom: 20px;
  }


  .new-in-title {
    font-size: 62px;

    line-height: 0.8;
  }


  .new-in-count {
    padding-bottom: 0;
  }


  .new-in-list {
    margin-top: 30px;
  }


  .new-in-row {
    display: grid;

    grid-template-columns:
      40px 1fr;

    gap: 8px 15px;

    padding: 22px 0;
  }


  .new-in-number {
    grid-column: 1;
    grid-row: 1 / span 2;
    align-self: start;
  }

  .new-in-product {
    grid-column: 2;
  }

  .new-in-product h2 {
    font-size: clamp(16px, 5vw, 20px);
    overflow-wrap: anywhere;
  }


  .new-in-description {
    grid-column: 2;
  }


  .new-in-price {
    grid-column: 2;
    grid-row: auto;

    align-items: flex-start;

    margin-top: 5px;
  }


  .new-in-actions {
    grid-column: 2;
    grid-row: auto;

    margin-top: 5px;

    align-items: flex-start;
  }

  .new-in-view,
  .new-in-add {
    width: 150px;
  }

}

@media (max-width: 360px) {
  .new-in-page {
    padding-right: 16px;
    padding-left: 16px;
  }

  .new-in-row {
    grid-template-columns: 30px minmax(0, 1fr);
    gap: 8px 10px;
  }

  .new-in-description p {
    font-size: 7px;
    letter-spacing: 1px;
  }

  .new-in-view,
  .new-in-add {
    width: min(150px, 100%);
  }
}
